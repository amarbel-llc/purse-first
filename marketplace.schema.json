{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anthropic.com/claude-code/marketplace.schema.json",
  "title": "Claude Code Plugin Marketplace",
  "description": "Schema for Claude Code plugin marketplace configuration",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URL"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique marketplace identifier (lowercase, alphanumeric with hyphens)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable marketplace description"
    },
    "version": {
      "type": "string",
      "description": "Marketplace version"
    },
    "owner": {
      "$ref": "#/definitions/Owner"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "pluginRoot": {
          "type": "string",
          "description": "Root directory for plugin sources"
        },
        "version": {
          "type": "string",
          "description": "Marketplace version (alternative to top-level version)"
        },
        "description": {
          "type": "string",
          "description": "Marketplace description (alternative to top-level description)"
        }
      },
      "description": "Optional marketplace metadata"
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Plugin"
      },
      "minItems": 1,
      "description": "List of plugins available in this marketplace"
    }
  },
  "definitions": {
    "Owner": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Owner name (person or organization)"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email address"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Owner URL"
        }
      }
    },
    "Author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Author name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Author email (optional)"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Author URL (optional)"
        }
      }
    },
    "Plugin": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unique plugin identifier"
        },
        "description": {
          "type": "string",
          "description": "Human-readable plugin description"
        },
        "version": {
          "type": "string",
          "description": "Plugin version"
        },
        "source": {
          "oneOf": [
            {
              "type": "string",
              "description": "Relative path to plugin directory"
            },
            {
              "type": "object",
              "required": ["source"],
              "properties": {
                "source": {
                  "type": "string",
                  "enum": ["github", "url", "npm", "pip"],
                  "description": "Source type"
                },
                "repo": {
                  "type": "string",
                  "description": "GitHub repository (owner/repo format)"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL for url source type"
                },
                "package": {
                  "type": "string",
                  "description": "Package name for npm/pip source types"
                }
              }
            }
          ],
          "description": "Plugin source: relative path string or source object"
        },
        "author": {
          "$ref": "#/definitions/Author"
        },
        "category": {
          "type": "string",
          "description": "Plugin category for discovery (free-form string)"
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "description": "Project homepage URL"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "description": "Source code repository URL"
        },
        "license": {
          "type": "string",
          "description": "SPDX license identifier"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Search keywords"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": "Searchable keywords"
        },
        "strict": {
          "type": "boolean",
          "description": "Whether to enforce strict plugin validation (defaults to true)"
        },
        "mcpServers": {
          "type": "object",
          "description": "MCP server configurations",
          "additionalProperties": true
        },
        "lspServers": {
          "type": "object",
          "description": "LSP server configurations",
          "additionalProperties": true
        },
        "skills": {
          "type": "object",
          "description": "Skill definitions",
          "additionalProperties": true
        },
        "hooks": {
          "type": "object",
          "description": "Hook definitions",
          "additionalProperties": true
        },
        "commands": {
          "type": "object",
          "description": "Command definitions",
          "additionalProperties": true
        },
        "agents": {
          "type": "object",
          "description": "Agent definitions",
          "additionalProperties": true
        },
        "outputStyles": {
          "type": "object",
          "description": "Output style definitions",
          "additionalProperties": true
        }
      }
    }
  }
}
