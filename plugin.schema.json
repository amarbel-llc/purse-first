{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anthropic.com/claude-code/plugin.schema.json",
  "title": "Claude Code Plugin",
  "description": "Schema for Claude Code plugin metadata",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique plugin identifier (lowercase, alphanumeric with hyphens)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable plugin description"
    },
    "version": {
      "type": "string",
      "description": "Plugin version"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Author name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Author email"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Author URL"
        }
      },
      "required": ["name"]
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Project homepage URL"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "description": "Source code repository URL"
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier (e.g., MIT, Apache-2.0)"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Search keywords"
    },
    "mcpServers": {
      "type": "object",
      "description": "MCP server configurations",
      "additionalProperties": true
    },
    "lspServers": {
      "type": "object",
      "description": "LSP server configurations",
      "additionalProperties": true
    },
    "skills": {
      "type": "object",
      "description": "Skill definitions",
      "additionalProperties": true
    },
    "hooks": {
      "type": "object",
      "description": "Hook definitions",
      "additionalProperties": true
    },
    "commands": {
      "type": "object",
      "description": "Command definitions",
      "additionalProperties": true
    },
    "agents": {
      "type": "object",
      "description": "Agent definitions",
      "additionalProperties": true
    },
    "outputStyles": {
      "type": "object",
      "description": "Output style definitions",
      "additionalProperties": true
    }
  }
}
